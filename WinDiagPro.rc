#include <winres.h>

// NOTE: This build does not embed a separate app.manifest as an RT_MANIFEST
// resource. The linker's own default manifest generation (GenerateManifest,
// on by default) already embeds a manifest at resource ID 1; adding our own
// here caused a duplicate-resource conflict (CVT1100) during linking on real
// MSVC builds. UAC elevation and the Common Controls v6 dependency are
// instead supplied via the UACExecutionLevel project property and a linker
// pragma in main.cpp, respectively - see the "Manifest handling" section in
// README.md for the full explanation.

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "William Ashley Music / AlphaAudio"
            VALUE "FileDescription", "WinDiagPro - Offline Windows Troubleshooter"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "WinDiagPro.exe"
            VALUE "OriginalFilename", "WinDiagPro.exe"
            VALUE "ProductName", "WinDiagPro"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
